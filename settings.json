{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(whoami*)",
      "Bash(pwd*)",
      "Bash(echo *)",
      "Bash(tree *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(stat *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(diff *)",
      "Bash(pbcopy)",
      "Bash(pbcopy *)",
      "Bash(pbpaste)",
      "Bash(pbpaste *)",
      "Glob",
      "Grep",
      "mcp__ccd_directory__change_directory",
      "mcp__ccd_directory__request_directory",
      "mcp__ccd_session_mgmt__set_session_title"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-git-push.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/joey/FyxerGh/fyxer-web-app-trees/.claude/hooks/blockLocalProviderKeys.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; echo \"$f\" | grep -q '/plans/' && afplay /System/Library/Sounds/Pop.aiff & } 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Checking for plan update..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "telegram@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "sf@sf": true,
    "portal@portal": false,
    "shunt@portal": false,
    "podium-reporter@eengelking-marketplace": false,
    "tool-skins@joey-mods": true,
    "savvy-progress@joey-savvy": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "portal": {
      "source": {
        "source": "github",
        "repo": "spotify/portal-ai-plugins"
      }
    },
    "ff": {
      "source": {
        "source": "directory",
        "path": "/Users/joey/.claude/local-plugins/ff"
      }
    },
    "eengelking-marketplace": {
      "source": {
        "source": "github",
        "repo": "eengelking/skills"
      }
    },
    "joey-mods": {
      "source": {
        "source": "directory",
        "path": "/Users/joey/.claude/dev-mods/13f35a49-2b88-4681-8fbd-5fe9a6c38110/tool-skins"
      }
    },
    "joey-savvy": {
      "source": {
        "source": "directory",
        "path": "/Users/joey/.claude/dev-mods/13f35a49-2b88-4681-8fbd-5fe9a6c38110/savvy-progress"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "pluginConfigs": {
    "ff@ff": {
      "options": {
        "branchPrefix": "joeydwonczyk",
        "prAssignee": "dwonczykj",
        "linearProject": "Product Engineering",
        "worktreeRoot": "~/FyxerGh/fyxer-web-app-trees"
      }
    },
    "podium-reporter@eengelking-marketplace": {
      "options": {
        "serverUrl": "http://127.0.0.1:4317",
        "showStatus": true,
        "explainFailures": false,
        "fullPrompts": false,
        "activityFeed": false,
        "respond": "off"
      }
    },
    "tool-skins@joey-mods": {
      "options": {
        "theme": "nord"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754131276564
  }
}
