# Ignore everything by default
*

# Exceptions
!.gitignore
!CLAUDE.md
!COMMANDS.md
!MCP.md
!MODES.md
!ORCHESTRATOR.md
!PERSONAS.md
!RULES.md
!settings.json

# Directories
!skills/
skills/**
!skills/*/
!skills/*/SKILL.md

!local-plugins/
!local-plugins/**

!plugins/
plugins/**
!plugins/blocklist.json
!plugins/known_marketplaces.json
!plugins/installed_plugins.json
!plugins/code-review/
!plugins/marketplaces/

!commands/
!commands/**

!hooks/
!hooks/**

!mcp/
!mcp/**

!scheduled-tasks/
!scheduled-tasks/**
scheduled-tasks/**/last-successful-run.txt
