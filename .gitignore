# Ignore everything by default
*

# Exceptions
!.gitignore
!README.md
!CLAUDE.md
!COMMANDS.md
!MCP.md
!MODES.md
!ORCHESTRATOR.md
!PERSONAS.md
!RULES.md
!settings.json

# Directories
!skills/
skills/**
!skills/*/
!skills/*/SKILL.md

!local-plugins/
!local-plugins/**

!plugins/
plugins/**
!plugins/blocklist.json
!plugins/known_marketplaces.json
!plugins/installed_plugins.json
!plugins/code-review/
!plugins/marketplaces/

!commands/
!commands/**

!hooks/
!hooks/**

!mcp/
!mcp/**

# scheduled-tasks: ignored by default so new tasks don't land in the repo.
# Already-tracked tasks stay tracked (gitignore doesn't untrack). To keep a NEW
# task, ! both its dir and its contents below (e.g. the two commented lines).
!scheduled-tasks/
scheduled-tasks/**
scheduled-tasks/**/last-successful-run.txt
scheduled-tasks/**/*.txt
# !scheduled-tasks/<task-name>/
# !scheduled-tasks/<task-name>/**
